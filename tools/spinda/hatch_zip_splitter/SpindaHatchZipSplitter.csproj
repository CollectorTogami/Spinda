<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(PKHEX_CORE_DLL)' != ''">
    <Reference Include="PKHeX.Core">
      <HintPath>$(PKHEX_CORE_DLL)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequirePkhexCore" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PKHEX_CORE_DLL)' == ''" Text="PKHeX.Core is an external GPL-3.0 dependency. Set PKHEX_CORE_DLL to the path of a compatible PKHeX.Core.dll before building." />
    <Error Condition="'$(PKHEX_CORE_DLL)' != '' and !Exists('$(PKHEX_CORE_DLL)')" Text="PKHEX_CORE_DLL does not exist: $(PKHEX_CORE_DLL)" />
  </Target>
</Project>
